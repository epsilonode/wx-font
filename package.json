{
  "name": "@epsilonode/wx-font",
  "version": "0.1.0",
  "private": true,
  "license": "OFL-1.1",
  "description": "Focused registry-driven WMO weather icon font for web and document pipelines",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./wmo": { "types": "./dist/wmo.d.ts", "default": "./dist/wmo.js" },
    "./wx-icons.css": "./dist/wx-icons.css",
    "./wx-icons.compat.css": "./dist/wx-icons.compat.css",
    "./wx-icons.colors.css": "./dist/wx-icons.colors.css",
    "./wx-wmo.css": "./dist/wx-wmo.css",
    "./wx-wmo.descriptions.css": "./dist/wx-wmo.descriptions.css",
    "./codepoints.json": "./dist/codepoints.json",
    "./wmo-contract.json": "./dist/wmo-contract.json",
    "./fonts/wx-font.ttf": "./dist/fonts/wx-font.ttf",
    "./fonts/wx-font.woff2": "./dist/fonts/wx-font.woff2"
  },
  "scripts": {
    "build": "mise run icon-build",
    "compile:proof": "mise run compile-proof",
    "icon:audit": "mise run icon-audit",
    "icon:build": "mise run icon-build",
    "icon:dist-verify": "mise run dist-verify",
    "icon:mapping-proof": "mise run mapping-proof",
    "icon:provenance-audit": "mise run provenance-audit",
    "icon:preview": "mise run icon-preview",
    "icon:watch": "mise run icon-watch",
    "icon:add": "mise run icon-add",
    "release:verify": "mise run release-verify",
    "release:assets-verify": "mise run release-assets-verify"
  },
  "dependencies": {
    "remeda": "2.39.0",
    "ts-pattern": "5.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.65.2",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.3.1",
    "@testing-library/user-event": "14.6.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "22.19.21",
    "@unocss/preset-uno": "66.7.2",
    "@unocss/reset": "66.7.2",
    "@unocss/svelte-scoped": "66.7.2",
    "@vitest/coverage-v8": "4.1.9",
    "@vitest/ui": "4.1.9",
    "@arethetypeswrong/cli": "0.18.3",
    "eslint": "10.5.0",
    "eslint-plugin-functional": "10.0.0",
    "eslint-plugin-svelte": "3.19.0",
    "fantasticon": "4.1.0",
    "css-tree": "3.2.1",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "lightningcss": "1.32.0",
    "opentype.js": "2.0.0",
    "prettier": "3.8.4",
    "prettier-plugin-svelte": "4.1.1",
    "publint": "0.3.21",
    "svelte": "5.56.3",
    "svelte-check": "4.6.0",
    "svelte-preprocess": "6.0.5",
    "svgo": "4.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "unocss": "66.7.2",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  }
}
